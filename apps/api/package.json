{
  "name": "@grocerycompare/api",
  "version": "1.0.0",
  "description": "GroceryCompare catalog and basket comparison API",
  "main": "dist/apps/api/src/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/apps/api/src/server.js",
    "prisma:generate": "prisma generate",
    "lint": "eslint src tests ../../packages/contracts",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "test:integration": "node --test -r ts-node/register tests/integration/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "prisma": "^6.16.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
