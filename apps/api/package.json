{
  "name": "@grocerycompare/api",
  "version": "1.0.0",
  "description": "GroceryCompare catalog and basket comparison API",
  "main": "dist/apps/api/src/server.js",
  "scripts": {
    "catalog": "ts-node scripts/catalog.ts",
    "feed:import": "ts-node scripts/import-feed.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/apps/api/src/server.js",
    "prisma:generate": "prisma generate",
    "lint": "eslint src tests ../../packages/contracts",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "test:integration": "node --test -r ts-node/register tests/integration/*.test.ts",
    "alerts:run": "ts-node scripts/alerts.ts",
    "feeds:poll": "ts-node scripts/poll-feeds.ts",
    "account:role": "ts-node scripts/account-role.ts",
    "worker": "ts-node scripts/worker.ts",
    "worker:start": "node dist/apps/api/scripts/worker.js",
    "test:redis": "node --test -r ts-node/register tests/redis/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^11.0.0",
    "bullmq": "^6.3.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "prisma": "^6.16.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
