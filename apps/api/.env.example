DATABASE_URL=postgresql://grocery:grocery@localhost:5432/grocerycompare?schema=public
PORT=5001
NODE_ENV=development
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=120
OFFER_MAX_AGE_SECONDS=86400
ALLOW_DEMO_DATA=true

# Optional account login: provision secrets outside Git. Do not use example values.
# AUTH_SECRET=
# SMTP_URL=
# SMTP_FROM=
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# Authorized normalized feeds only (repeat for ZEPTO, SWIGGY, BIGBASKET, DMART_READY).
# FEED_BLINKIT_URL=
# FEED_BLINKIT_TOKEN=
# Required for production API and all background workers.
# REDIS_URL=redis://127.0.0.1:6379
# METRICS_TOKEN=
# WORKER_METRICS_PORT=5002
# WORKER_METRICS_HOST=127.0.0.1
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
