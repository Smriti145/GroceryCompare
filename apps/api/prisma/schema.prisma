generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Product {
  id String @id @default(uuid())
  name String
  brand String
  category String
  quantity String @default("")
  variants Variant[]
  retailerOffers RetailerOffer[]
  mappings CanonicalMapping[]
  variantName String @default("")
  imageUrl String?
  deletedAt DateTime?
  retailerListings RetailerProduct[]
  // Tags must come from trusted catalog curation; absence means unknown.
  dietaryTags String[] @default([])
  @@index([category, id])
}
model Variant {
  id String @id @default(uuid())
  platform String
  platformSku String
  platformName String
  quantity String
  price Decimal @db.Decimal(12, 2)
  deliveryTime Int
  productId String
  product Product @relation(fields: [productId], references: [id])
  location String @default("DEMO")
  available Boolean @default(true)
  isDemo Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([platform, platformSku, location])
  @@index([productId, location, available])
}
model CartItem {
  id String @id @default(uuid())
  productName String
  quantity String
}

// Authorized source observations, isolated from legacy/demo comparisons.
model RetailerOffer {
  directory RetailerStore @relation(fields: [retailer, storeId, sellerId], references: [retailer, storeId, sellerId])
  listing RetailerProduct @relation(fields: [retailer, sku], references: [retailer, sku])
  id String @id @default(uuid())
  retailer String
  sku String
  location String
  storeId String
  sellerId String
  productId String
  packSize String
  product Product @relation(fields: [productId], references: [id])
  pricePaise Int
  mrpPaise Int?
  inStock Boolean
  stockQuantity Int?
  etaMinutes Int?
  feesPaise Int?
  minimumOrderPaise Int?
  observedAt DateTime
  receivedAt DateTime @default(now())
  @@unique([retailer, sku, location, storeId, sellerId])
  @@index([productId, location, observedAt])
}

model ServiceArea {
  directory RetailerStore @relation(fields: [retailer, storeId, sellerId], references: [retailer, storeId, sellerId])
  id String @id @default(uuid())
  retailer String
  storeId String
  sellerId String
  warehouseId String?
  pincode String
  // Pincode coverage must be explicitly guaranteed by the provider.
  entirePincode Boolean @default(false)
  latitude Float?
  longitude Float?
  radiusMeters Int?
  serving Boolean
  etaMinutes Int
  observedAt DateTime
  expiresAt DateTime
  source String
  tariff Json?
  @@unique([retailer, storeId, sellerId, pincode])
  @@index([pincode, serving, expiresAt])
}

model CanonicalMapping {
  id String @id @default(uuid())
  retailer String
  sku String
  productId String
  product Product @relation(fields: [productId], references: [id])
  // Fingerprint invalidates a correction when the retailer changes the SKU's identity.
  fingerprint String
  reason String
  reviewedBy String
  updatedAt DateTime @updatedAt
  @@unique([retailer, sku])
}

// Immutable source observations. Uniqueness deduplicates retried feed deliveries.
model PriceSnapshot {
  id String @id @default(uuid())
  retailer String
  sku String
  location String
  storeId String
  sellerId String
  productId String
  packSize String
  pricePaise Int
  inStock Boolean
  observedAt DateTime
  receivedAt DateTime @default(now())
  @@unique([retailer, sku, location, storeId, sellerId, observedAt])
  @@index([productId, location, observedAt])
}
model Account {
  id String @id @default(uuid())
  email String @unique
  role String @default("USER")
  preferences Json @default("{}")
  createdAt DateTime @default(now())
  savedCarts SavedCart[]
  auditLogs AuditLog[]
  reports UserReport[]
  sessions DeviceSession[]
  identities SocialIdentity[]
  watches Watch[]
  alerts Alert[]
}
model SocialIdentity {
  id String @id @default(uuid())
  issuer String
  subject String
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([issuer, subject])
}
model DeviceSession {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceName String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  refreshTokens RefreshToken[]
  @@index([accountId])
}
model RefreshToken {
  hash String @id
  sessionId String
  session DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt DateTime?
}
model LoginChallenge {
  id String @id @default(uuid())
  email String?
  kind String
  secretHash String
  attempts Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  @@index([email, createdAt])
}
model Watch {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind String
  config Json
  baseline Json?
  createdAt DateTime @default(now())
  lastCheckedAt DateTime?
  alerts Alert[]
  @@index([accountId])
}
model Alert {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  watchId String
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  message String
  dedupeKey String @unique
  createdAt DateTime @default(now())
  readAt DateTime?
  @@index([accountId, createdAt])
}

model ProviderHealth {
  retailer String @id
  snapshot Json
  updatedAt DateTime @updatedAt
}

model Retailer {
  id String @id
  name String
  deletedAt DateTime?
  stores RetailerStore[]
  products RetailerProduct[]
}
model RetailerStore {
  offers RetailerOffer[]
  coverage ServiceArea[]
  id String @id @default(uuid())
  retailer String
  storeId String
  sellerId String
  warehouseId String?
  deletedAt DateTime?
  provider Retailer @relation(fields: [retailer], references: [id])
  @@unique([retailer, storeId, sellerId])
}
model RetailerProduct {
  offers RetailerOffer[]
  id String @id @default(uuid())
  retailer String
  sku String
  title String
  packSize String
  canonicalId String?
  status String @default("UNMATCHED")
  deletedAt DateTime?
  provider Retailer @relation(fields: [retailer], references: [id])
  canonical Product? @relation(fields: [canonicalId], references: [id], onDelete: SetNull)
  @@unique([retailer, sku])
  @@index([status, id])
}
model DeliveryEstimate {
  id String @id @default(uuid())
  retailer String
  storeId String
  sellerId String
  pincode String
  etaMinutes Int
  observedAt DateTime
  expiresAt DateTime
  @@unique([retailer, storeId, sellerId, pincode, observedAt])
  @@index([pincode, expiresAt])
}
model SavedCart {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name String
  pincode String
  items Json
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([accountId, deletedAt])
}
model ComparisonShare {
  id String @id
  pincode String
  items Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model SearchAlias {
  term String @id
  replacement String
  kind String
}
model SearchTrend {
  pincode String
  term String
  count Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([pincode, term])
  @@index([pincode, count])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actor Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  objectType String
  objectId String
  reason String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([objectType, objectId])
}
model UserReport {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String?
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}
