generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Product {
  id String @id @default(uuid())
  name String
  brand String
  category String
  quantity String @default("")
  variants Variant[]
  @@index([category, id])
}
model Variant {
  id String @id @default(uuid())
  platform String
  platformSku String
  platformName String
  quantity String
  price Decimal @db.Decimal(12, 2)
  deliveryTime Int
  productId String
  product Product @relation(fields: [productId], references: [id])
  location String @default("DEMO")
  available Boolean @default(true)
  isDemo Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([platform, platformSku, location])
  @@index([productId, location, available])
}
model CartItem {
  id String @id @default(uuid())
  productName String
  quantity String
}
