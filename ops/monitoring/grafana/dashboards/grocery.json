{
  "title": "GroceryCompare operations",
  "uid": "grocery-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grocery-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gc_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grocery-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gc_http_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Job outcomes / minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grocery-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(gc_jobs_total[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grocery-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_success{job=\"readiness\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
